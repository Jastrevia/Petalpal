# iPhone Release build for testers (npm run ios:device:release). Copy to .env.ios.usability-test and fill in; the copy is git-ignored.
# EXPO_PUBLIC_* values are bundled into the app: client configuration, never server secrets.
#
# All five are required and must be one matched TEST set. The build script refuses the production API or
# Firebase project. During a test round: no deployment to this backend and no migration on its database.
EXPO_PUBLIC_API_BASE_URL=https://petalpal-backend-test.onrender.com
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Only if someone other than the first Apple ID signs builds: a bundle ID of their own.
# PETALPAL_IOS_DEV_BUNDLE_ID=com.yourname.petalpal.dev
