# iPhone Debug build (npm run ios:device). Copy to .env.ios.development and fill in; the copy is git-ignored.
# EXPO_PUBLIC_* values are bundled into the app: client configuration, never server secrets.
#
# All five are required. Firebase falls back to the production project when a value is missing,
# so the build script refuses to run unless the API and Firebase settings below are one matched set.
EXPO_PUBLIC_API_BASE_URL=https://petalpal-backend-test.onrender.com
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Only if someone other than the first Apple ID signs builds: a bundle ID of their own.
# PETALPAL_IOS_DEV_BUNDLE_ID=com.yourname.petalpal.dev
