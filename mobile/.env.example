# PetalPal mobile — local environment template.
#
# Copy this file to `.env` in this folder (mobile/), fill in the values below,
# then run `npm install` and `npx expo start`. `.env` is git-ignored, so it is
# never committed and does not come down when you pull.
#
# EXPO_PUBLIC_* values are bundled into the client app; they are configuration,
# not server secrets, and are safe to share with the team.

# Backend the app talks to. Use the production backend for normal local dev:
EXPO_PUBLIC_API_BASE_URL=https://petalpal-v2.onrender.com

# Firebase Web client API key — REQUIRED to sign in.
# Get it from: Firebase Console -> Project settings -> General ->
#   Your apps (Web app) -> SDK setup and configuration -> apiKey
# Firebase project: petalpal-b212c
EXPO_PUBLIC_FIREBASE_API_KEY=

# Optional — the app already defaults these to the petalpal-b212c project.
# Only uncomment and set them to point at a different Firebase project:
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=petalpal-b212c.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=petalpal-b212c
# EXPO_PUBLIC_FIREBASE_APP_ID=1:879846854472:web:02b860eacfaf5bb7616d7d
