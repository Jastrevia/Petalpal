// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String      @id
  accountId             String?     @unique
  name                  String
  email                 String?     @unique
  firebaseUid           String?     @unique
  emailVerifiedAt       DateTime?
  avatar                String      @default("🦋")
  timezone              String      @default("UTC") @db.VarChar(64)
  preferredLocale       String      @default("en") @db.VarChar(35)
  allowGardenVisits     Boolean     @default(true)
  socialRestricted      Boolean     @default(false)
  communityTermsVersion String?     @db.VarChar(64)
  communityAcceptedAt   DateTime?
  blocksMade            UserBlock[] @relation("Blocker")
  blocksReceived        UserBlock[] @relation("Blocked")
  createdAt             DateTime    @default(now())

  garden       Garden?
  flowers      Flower[]
  messages     Message[]
  visitRecords VisitRecord[]

  friends  Friendship[] @relation("UserFriends")
  friendOf Friendship[] @relation("FriendOf")

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")

  dailyCheckIns           DailyCheckIn[]
  journals                Journal[]
  emotionResults          EmotionResult[]
  fairyState              FairyState?
  reportsCreated          Report[]                 @relation("ReportReporter")
  reportsReceived         Report[]                 @relation("ReportTargetUser")
  aiConsent               AiConsent?
  aiInteractions          AiInteractionMetadata[]
  subscriptionEntitlement SubscriptionEntitlement?
  fairies                 UserFairy[]
  fairyMonthlyProgress    FairyMonthlyProgress[]
  fairyMoments            FairyMoment[]
  fairyCheckIns           FairyCheckIn[]
  fairyKeepsakeGrants     FairyKeepsakeGrant[]
  fairyClosenessAwards    FairyClosenessAward[]
  petalCardDraws          PetalCardDraw[]
  petalCardReadings       PetalCardReading[]
  redeemCodeClaims        RedeemCodeClaim[]
  dailyFlowerQuotas       DailyFlowerQuota[]
  events                  Event[]
  eventMemories           EventMemory[]
  eventInsightExtractions EventInsightExtraction[]
  insightKeeps            InsightKeep[]
  insightThreads          InsightThread[]
  questionAnswers         QuestionAnswer[]
  futureLetters           FutureLetter[]
  insightMutes            InsightMute[]
  weeklyReports           WeeklyReport[]
  monthlyReports          MonthlyReport[]
  yearlyReports           YearlyReport[]
  aiJobs                  AiJob[]
  aiEvidence              AiEvidence[]
  messageReactions MessageReaction[] @relation("MessageReactionUser")
}

model Garden {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  year      Int      @default(2026)
  createdAt DateTime @default(now())

  owner        User          @relation(fields: [ownerId], references: [id])
  flowers      Flower[]
  visitRecords VisitRecord[]
}

model Flower {
  id             String   @id @default(cuid())
  mood           String
  speciesCode    String?  @db.VarChar(32)
  colorAccent    String?  @db.VarChar(32)
  event          String   @default("")
  name           String
  meaning        String
  img            String
  left           Float
  top            Float
  regionId       String?  @db.VarChar(64)
  slotId         String?  @db.VarChar(64)
  // Garden world position, written once when the owner plants the flower (regionId holds its
  // land, e.g. "Land04"). Null until planted; never changed afterwards (lib/flower-placement.js).
  worldX         Float?
  worldY         Float?
  placedAt       DateTime?
  scale          Float    @default(1)
  rotation       Float    @default(0)
  layer          Int      @default(0)
  layoutVersion  Int      @default(1)
  supportCount   Int      @default(0)
  variant        String   @default("standard") @db.VarChar(32)
  rarity         String   @default("COMMON") @db.VarChar(16)
  growthState    String   @default("BLOOMED") @db.VarChar(32)
  visualEffect   String?  @db.VarChar(32)
  season         String?  @db.VarChar(16)
  generationSeed String?  @db.VarChar(64)
  createdAt      DateTime @default(now())

  userId         String
  gardenId       String
  dailyCheckInId String? @unique
  sourceEventId  String? @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden       Garden        @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  dailyCheckIn DailyCheckIn? @relation(fields: [dailyCheckInId], references: [id], onDelete: Cascade)
  sourceEvent  Event?        @relation(fields: [sourceEventId, userId], references: [id, ownerId], onDelete: Cascade)
  messages     Message[]
  visitRecords VisitRecord[]

  @@unique([sourceEventId, userId])
}

model Message {
  id        String   @id @default(cuid())
  author    String   @default("Friend")
  text      String   @default("")
  createdAt DateTime @default(now())

  flowerId String
  userId   String?

  flower  Flower   @relation(fields: [flowerId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  reports Report[]
  reactions MessageReaction[]
}

enum MessageReactionKind {
  LIKE
  DISLIKE
}

// One reaction per person per message, and the first one stands. A dislike comes with a Report.
model MessageReaction {
  id        String              @id @default(cuid())
  messageId String
  userId    String
  kind      MessageReactionKind
  createdAt DateTime            @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model VisitRecord {
  id            String   @id @default(cuid())
  visitorId     String
  visitorName   String
  visitorAvatar String
  action        String
  createdAt     DateTime @default(now())

  gardenId  String
  userId    String?
  // Only daily flower Support records populate these fields. Other visits and
  // pre-existing aggregate Support history remain unchanged.
  flowerId  String?
  localDate String? @db.VarChar(10)
  timezone  String? @db.VarChar(64)

  garden Garden  @relation(fields: [gardenId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
  flower Flower? @relation(fields: [flowerId], references: [id], onDelete: SetNull)

  @@unique([visitorId, flowerId, localDate])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model DailyCheckIn {
  id                 String   @id @default(cuid())
  userId             String
  localDate          String   @db.VarChar(10)
  timezone           String   @default("UTC") @db.VarChar(64)
  dailyLimitEnforced Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal        Journal?
  emotionResult  EmotionResult?
  flower         Flower?
  aiInteractions AiInteractionMetadata[]

  @@index([userId, createdAt])
}

model Journal {
  id             String   @id @default(cuid())
  userId         String
  dailyCheckInId String?  @unique
  content        String   @db.Text
  coverImage     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckIn DailyCheckIn? @relation(fields: [dailyCheckInId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model EmotionResult {
  id                String        @id @default(cuid())
  userId            String
  dailyCheckInId    String        @unique
  label             String        @db.VarChar(32)
  source            EmotionSource
  confidence        Float?
  secondaryEmotion  String?       @db.VarChar(32)
  secondaryEmotions Json          @default("[]")
  intensity         Float?
  modelVersion      String?       @db.VarChar(128)
  inferencePath     String        @default("NO_AI") @db.VarChar(32)
  createdAt         DateTime      @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckIn DailyCheckIn @relation(fields: [dailyCheckInId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([inferencePath, createdAt])
}

model FairyState {
  id                  String    @id @default(cuid())
  userId              String    @unique
  onboardingStep      String    @default("EMPTY_GARDEN") @db.VarChar(64)
  onboardingCompleted Boolean   @default(false)
  lastEvent           String?   @db.VarChar(64)
  unlockedFeatures    Json      @default("[]")
  /// Deprecated runtime columns retained temporarily for a safe production migration.
  currentState        String    @default("IDLE") @db.VarChar(32)
  currentLocation     String    @default("GARDEN_CENTER") @db.VarChar(32)
  stateStartedAt      DateTime?
  nextTransitionAt    DateTime?
  lastActiveAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserFairy {
  id            String    @id @default(cuid())
  userId        String
  fairyType     String    @db.VarChar(64)
  name          String    @db.VarChar(64)
  unlockSource  String    @db.VarChar(32)
  unlockMonth   String?   @db.VarChar(7)
  isActive      Boolean   @default(false)
  level         Int       @default(1)
  progression   Int       @default(0)
  unlockedAt    DateTime  @default(now())
  /// Newest Moment the owner has opened; later Moments show the unread dot.
  momentsSeenAt DateTime?
  /// Avatar-library id (lib/avatars.js) shown on her Moments; null = her default photo.
  momentsAvatar String?   @db.VarChar(32)
  /// Cover-library id (lib/moment-covers.js) at the top of her Moments; null = default photo.
  momentsCover  String?   @db.VarChar(32)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  runtime       FairyRuntime?
  monthlyUnlock FairyMonthlyProgress?
  moments       FairyMoment[]

  @@unique([userId, fairyType])
  @@unique([userId, unlockMonth])
  @@index([userId, unlockedAt])
}

model FairyRuntime {
  id               String    @id @default(cuid())
  userFairyId      String    @unique
  currentState     String    @default("IDLE") @db.VarChar(32)
  currentLocation  String    @default("DEFAULT_AREA") @db.VarChar(32)
  previousState    String?   @db.VarChar(32)
  previousLocation String?   @db.VarChar(32)
  stateStartedAt   DateTime?
  nextTransitionAt DateTime?
  lastActiveAt     DateTime?
  transitionId     String?   @db.VarChar(64)
  runtimeVersion   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  fairy UserFairy @relation(fields: [userFairyId], references: [id], onDelete: Cascade)
}

/// A post on the Fairy's own Moments feed while in a runtime state: a selfie or a
/// text-only small discovery. One per runtime transition; visible only to the owner.
model FairyMoment {
  id             String    @id @default(cuid())
  userId         String
  userFairyId    String
  runtimeVersion Int
  state          String    @db.VarChar(32)
  /// Walk sight for IDLE posts (PAVILION, EAST_BRIDGE, ...); null otherwise.
  spot           String?   @db.VarChar(32)
  /// The Fairy's own mood that day (HAPPY, CURIOUS, ...), never the owner's.
  mood           String?   @db.VarChar(16)
  /// Bundled photo key; null for a text-only post.
  photoKey       String?   @db.VarChar(64)
  caption        String    @db.VarChar(280)
  captionSource  String    @default("FALLBACK") @db.VarChar(16)
  postedAt       DateTime
  likedAt        DateTime?
  createdAt      DateTime  @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fairy UserFairy @relation(fields: [userFairyId], references: [id], onDelete: Cascade)

  @@unique([userFairyId, runtimeVersion])
  @@index([userId, postedAt])
}

/// One calendar check-in per account-local day (lib/fairy-closeness.js). `streak` counts
/// consecutive days, one missed day a week bridged (`graceUsed`).
model FairyCheckIn {
  id        String   @id @default(cuid())
  userId    String
  localDate String   @db.VarChar(10)
  timezone  String   @db.VarChar(64)
  streak    Int
  graceUsed Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  keepsakes FairyKeepsakeGrant[]

  @@unique([userId, localDate])
}

// New flowers planted on one account-local day; deleting a flower never lowers it.
model DailyFlowerQuota {
  userId    String
  localDate String   @db.VarChar(10)
  planted   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, localDate])
}

/// A keepsake PPL gave the owner (lib/fairy-keepsakes.js ids); the collection is these rows.
model FairyKeepsakeGrant {
  id         String   @id @default(cuid())
  userId     String
  checkInId  String?
  keepsakeId String   @db.VarChar(48)
  reason     String   @db.VarChar(16)
  localDate  String   @db.VarChar(10)
  createdAt  DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn FairyCheckIn? @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate, reason])
  @@index([userId, keepsakeId])
}

/// Closeness ledger: one row per award, `awardKey` makes each award idempotent and the
/// per-day caps count rows by (source, localDate). The level is derived from the sum.
model FairyClosenessAward {
  id        String   @id @default(cuid())
  userId    String
  source    String   @db.VarChar(16)
  awardKey  String   @db.VarChar(96)
  localDate String   @db.VarChar(10)
  points    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, awardKey])
  @@index([userId, localDate])
}

/// The daily petal card draw (lib/petal-card-draw.js): one per account-local day; `position`
/// is the place chosen in that day's shuffled deck, `cardId` the card it held.
model PetalCardDraw {
  id        String   @id @default(cuid())
  userId    String
  localDate String   @db.VarChar(10)
  position  Int
  cardId    String   @db.VarChar(32)
  /// What the owner asked about (lib/petal-card-draw.js PETAL_TOPICS); null for draws made before topics.
  topic     String?  @db.VarChar(16)
  reversed  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading PetalCardReading?

  @@unique([userId, localDate])
}

/// A model-written reading of one daily draw (lib/petal-reading.js), for Premium or listed owners:
/// the card, its orientation and the chosen topic, plus the last week's mood counts when
/// Personalization is on (never Event or Journal text). `status` is GENERATING, READY or FAILED;
/// at most PETAL_READING_MAX_ATTEMPTS model calls per draw. Goes with the draw and the account.
model PetalCardReading {
  id         String   @id @default(cuid())
  userId     String
  drawId     String   @unique
  locale     String   @db.VarChar(8)
  status     String   @db.VarChar(16)
  attempts   Int      @default(1)
  paragraphs Json     @default("[]")
  model      String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  draw PetalCardDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A redeemed code (lib/redeem-codes.js): the code's SHA-256, never the code. Each code once,
/// ever (the row stays, without its owner, if the account is deleted); one code per account
/// and batch. `rewardStatus` is "pending" until the reward is granted.
model RedeemCodeClaim {
  id           String    @id @default(cuid())
  codeHash     String    @unique @db.VarChar(64)
  batch        String    @db.VarChar(64)
  reward       String    @db.VarChar(64)
  rewardStatus String    @default("pending") @db.VarChar(16)
  userId       String?
  createdAt    DateTime  @default(now())
  grantedAt    DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, batch])
}

model FairyMonthlyProgress {
  id                String   @id @default(cuid())
  userId            String
  month             String   @db.VarChar(7)
  activeDays        Int      @default(0)
  requiredDays      Int
  unlockedThisMonth Boolean  @default(false)
  unlockedFairyId   String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  unlockedFairy UserFairy? @relation(fields: [unlockedFairyId], references: [id], onDelete: SetNull)

  @@unique([userId, month])
  @@index([userId, month])
}

model Report {
  id             String         @id @default(cuid())
  reporterId     String
  reportedUserId String?
  messageId      String?
  aiOutputKind   String?        @db.VarChar(16)
  aiOutputId     String?        @db.VarChar(128)
  category       ReportCategory
  details        String?        @db.Text
  status         ReportStatus   @default(PENDING)
  resolutionNote String?        @db.Text
  createdAt      DateTime       @default(now())
  reviewedAt     DateTime?

  reporter     User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportTargetUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

model AiConsent {
  id              String    @id @default(cuid())
  userId          String    @unique
  termsVersion    String    @db.VarChar(32)
  aiProcessing    Boolean   @default(false)
  personalization Boolean   @default(false)
  memoryEnabled   Boolean   @default(false)
  grantedAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  eventType     String   @db.VarChar(64)
  outcome       String   @db.VarChar(32)
  correlationId String?  @db.VarChar(128)
  actorUserId   String?  @db.VarChar(128)
  targetClass   String   @db.VarChar(64)
  targetSafeId  String?  @db.VarChar(128)
  actionCode    String?  @db.VarChar(64)
  reasonCode    String?  @db.VarChar(64)

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
}

model AiInteractionMetadata {
  id             String   @id @default(cuid())
  userId         String
  dailyCheckInId String?
  task           String   @db.VarChar(64)
  provider       String   @db.VarChar(64)
  model          String   @db.VarChar(128)
  inputHash      String?  @db.VarChar(64)
  outputLabel    String?  @db.VarChar(64)
  confidence     Float?
  latencyMs      Int?
  inputTokens    Int?
  outputTokens   Int?
  success        Boolean  @default(true)
  errorCode      String?  @db.VarChar(64)
  inferencePath  String?  @db.VarChar(32)
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckIn DailyCheckIn? @relation(fields: [dailyCheckInId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([task, createdAt])
  @@index([inferencePath, createdAt])
}

/// A user-authored, private source for the long-term AI subsystem.
/// Journal is intentionally a separate model and has no AI relations.
model Event {
  id                      String   @id @default(cuid())
  ownerId                 String
  content                 String   @db.Text
  occurredAt              DateTime
  timezone                String   @db.VarChar(64)
  localDate               String   @db.VarChar(10)
  idempotencyKey          String   @db.VarChar(191)
  memoryProcessingAllowed Boolean  @default(false)
  consentTermsVersion     String?  @db.VarChar(32)
  primaryGardenMood       String?  @db.VarChar(32)
  secondaryEmotions       Json     @default("[]")
  emotionStatus           String   @default("SKIPPED") @db.VarChar(16)
  emotionOutcome          String   @default("SKIPPED") @db.VarChar(32)
  emotionProvenance       String?  @db.VarChar(32)
  emotionModelId          String?  @db.VarChar(128)
  emotionModelVersion     String?  @db.VarChar(128)
  emotionModelStatus      String?  @db.VarChar(32)
  emotionProbabilities    Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  owner    User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memory   EventMemory?
  insightExtraction EventInsightExtraction?
  questionAnswer    QuestionAnswer?
  aiJobs   AiJob[]
  evidence AiEvidence[]
  flower   Flower?

  @@unique([id, ownerId])
  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, occurredAt])
  @@index([ownerId, localDate])
}

model EventMemory {
  id                     String                      @id @default(cuid())
  ownerId                String
  sourceEventId          String                      @unique
  memoryType             String                      @db.VarChar(64)
  summary                String                      @db.Text
  topics                 Json                        @default("[]")
  people                 Json                        @default("[]")
  importanceScore        Float?
  eventDate              DateTime
  primaryMood            String?                     @db.VarChar(32)
  secondaryEmotions      Json?
  emotionConfidence      Float?
  emotionModelVersion    String?                     @db.VarChar(128)
  emotionOutcome         String?                     @db.VarChar(32)
  emotionProvenance      String?                     @db.VarChar(32)
  emotionModelId         String?                     @db.VarChar(128)
  emotionModelStatus     String?                     @db.VarChar(32)
  emotionProbabilities   Json?
  embeddingStatus        String                      @default("NOT_REQUESTED") @db.VarChar(32)
  embeddingModel         String?                     @db.VarChar(128)
  embeddingProfileKey    String?                     @db.VarChar(128)
  embeddingModelRevision String?                     @db.VarChar(128)
  embeddingInputVersion  String?                     @db.VarChar(32)
  embeddingInputRevision Int                         @default(1)
  embeddedInputRevision  Int?
  embedding              Unsupported("vector(384)")?
  embeddedAt             DateTime?
  memoryVersion          String                      @default("v1") @db.VarChar(32)
  extractionVersion      String                      @default("v1") @db.VarChar(32)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  owner       User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceEvent Event                  @relation(fields: [sourceEventId, ownerId], references: [id, ownerId], onDelete: Cascade)
  evidence    AiEvidence[]
  embeddings  EventMemoryEmbedding[]

  @@unique([sourceEventId, ownerId])
  @@unique([id, ownerId])
  @@index([ownerId, eventDate])
  @@index([ownerId, memoryType])
}

/// Weekly 2.0 fact spans for one Event (lib/insight-extract.js; docs/product/WEEKLY_2.0.md): people,
/// places, activities, plans, own questions, self-talk, body signals and small good things, each with
/// the exact text and its [start, end) offsets in Event.content. Made once per Event (Haiku through the
/// AI Gateway when configured, else code rules); goes with the Event and the account.
model EventInsightExtraction {
  id                String   @id @default(cuid())
  ownerId           String
  sourceEventId     String   @unique
  extractionVersion String   @db.VarChar(32)
  status            String   @db.VarChar(16)
  sensitive         Boolean  @default(false)
  spans             Json     @default("[]")
  model             String?  @db.VarChar(64)
  sourceUpdatedAt   DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner       User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceEvent Event @relation(fields: [sourceEventId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([sourceEventId, ownerId])
  @@index([ownerId])
}

/// Weekly 2.0 花语集 (docs/product/WEEKLY_2.0.md): an insight or petal card the owner kept. Only a pointer to that section
/// of the saved report (no copied text), so it goes when the report goes.
model InsightKeep {
  id             String   @id @default(cuid())
  ownerId        String
  weeklyReportId String
  sectionIndex   Int
  kind           String   @db.VarChar(16)
  cardId         String?  @db.VarChar(32)
  createdAt      DateTime @default(now())

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  weeklyReport WeeklyReport @relation(fields: [weeklyReportId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([ownerId, weeklyReportId, sectionIndex])
  @@index([ownerId, createdAt])
}

/// Weekly 2.0 跟进线索: a word from one of the owner's insights that each later Weekly counts (at most 3 active).
model InsightThread {
  id          String    @id @default(cuid())
  ownerId     String
  word        String    @db.VarChar(64)
  insightType String    @db.VarChar(24)
  createdAt   DateTime  @default(now())
  endedAt     DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, endedAt])
}

/// Weekly 2.0 回答问题: an Event the owner wrote to answer a Weekly report's question; the next Weekly quotes it.
model QuestionAnswer {
  id             String   @id @default(cuid())
  ownerId        String
  eventId        String   @unique
  weeklyReportId String
  createdAt      DateTime @default(now())

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId, ownerId], references: [id, ownerId], onDelete: Cascade)
  weeklyReport WeeklyReport @relation(fields: [weeklyReportId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([eventId, ownerId])
  @@index([ownerId, weeklyReportId])
}

/// Weekly 2.0 给未来的信: one sentence the owner wrote to a later self, shown in the Weekly of the week holding deliverOn
/// (an account-timezone local date); withdrawable until then.
model FutureLetter {
  id          String    @id @default(cuid())
  ownerId     String
  text        String    @db.VarChar(280)
  deliverOn   String    @db.VarChar(10)
  createdAt   DateTime  @default(now())
  withdrawnAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, deliverOn])
}

/// Weekly 2.0 屏蔽: a word (a name or topic) the owner asked insights never to use.
model InsightMute {
  id        String   @id @default(cuid())
  ownerId   String
  word      String   @db.VarChar(64)
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, word])
}

model EventMemoryEmbedding {
  eventMemoryId String
  ownerId       String
  profileKey    String                      @db.VarChar(128)
  model         String                      @db.VarChar(128)
  modelRevision String                      @db.VarChar(128)
  inputVersion  String                      @db.VarChar(32)
  inputRevision Int
  status        String                      @default("NOT_REQUESTED") @db.VarChar(32)
  embedding     Unsupported("vector(384)")?
  embeddedAt    DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  memory EventMemory @relation(fields: [eventMemoryId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@id([eventMemoryId, profileKey, inputRevision])
  @@index([ownerId, profileKey, status])
}

model WeeklyReport {
  id                String                  @id @default(cuid())
  ownerId           String
  timezone          String                  @db.VarChar(64)
  periodKey         String                  @db.VarChar(10)
  periodStartUtc    DateTime
  periodEndUtc      DateTime
  asOf              DateTime
  status            AIReportStatus          @default(COMPLETE)
  eventCount        Int
  topTopics         Json                    @default("[]")
  importantEventIds Json                    @default("[]")
  trendSignals      Json                    @default("{}")
  summary           String?                 @db.Text
  narrativeStatus   AIReportNarrativeStatus @default(NOT_GENERATED)
  narrativeSections Json                    @default("[]")
  generationVersion String                  @default("deterministic-v1") @db.VarChar(64)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  owner    User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  evidence AiEvidence[]
  keeps    InsightKeep[]
  answers  QuestionAnswer[]

  @@unique([id, ownerId])
  @@unique([ownerId, periodKey])
  @@index([ownerId, periodStartUtc])
}

model MonthlyReport {
  id                   String                  @id @default(cuid())
  ownerId              String
  timezone             String                  @db.VarChar(64)
  periodKey            String                  @db.VarChar(7)
  periodStartUtc       DateTime
  periodEndUtc         DateTime
  asOf                 DateTime
  status               AIReportStatus          @default(COMPLETE)
  year                 Int
  month                Int
  eventCount           Int
  topTopics            Json                    @default("[]")
  importantEventIds    Json                    @default("[]")
  trendSignals         Json                    @default("{}")
  turningPointEventIds Json                    @default("[]")
  summary              String?                 @db.Text
  narrativeStatus      AIReportNarrativeStatus @default(NOT_GENERATED)
  narrativeSections    Json                    @default("[]")
  generationVersion    String                  @default("deterministic-v1") @db.VarChar(64)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  owner    User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  evidence AiEvidence[]

  @@unique([id, ownerId])
  @@unique([ownerId, year, month])
  @@unique([ownerId, periodKey])
  @@index([ownerId, periodStartUtc])
}

model YearlyReport {
  id                String         @id @default(cuid())
  ownerId           String
  timezone          String         @db.VarChar(64)
  periodKey         String         @db.VarChar(4)
  periodStartUtc    DateTime
  periodEndUtc      DateTime
  asOf              DateTime
  status            AIReportStatus @default(COMPLETE)
  year              Int
  eventCount        Int
  topTopics         Json           @default("[]")
  trendSignals      Json           @default("{}")
  summary           String?        @db.Text
  generationVersion String         @default("deterministic-v1") @db.VarChar(64)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  owner    User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  evidence AiEvidence[]

  @@unique([id, ownerId])
  @@unique([ownerId, year])
  @@unique([ownerId, periodKey])
  @@index([ownerId, periodStartUtc])
}

model AiEvidence {
  id              String   @id @default(cuid())
  ownerId         String
  sourceEventId   String
  sourceMemoryId  String?
  claimType       String?  @db.VarChar(64)
  weeklyReportId  String?
  monthlyReportId String?
  yearlyReportId  String?
  createdAt       DateTime @default(now())

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceEvent   Event          @relation(fields: [sourceEventId, ownerId], references: [id, ownerId], onDelete: Cascade)
  sourceMemory  EventMemory?   @relation(fields: [sourceMemoryId, ownerId], references: [id, ownerId], onDelete: Cascade)
  weeklyReport  WeeklyReport?  @relation(fields: [weeklyReportId, ownerId], references: [id, ownerId], onDelete: Cascade)
  monthlyReport MonthlyReport? @relation(fields: [monthlyReportId, ownerId], references: [id, ownerId], onDelete: Cascade)
  yearlyReport  YearlyReport?  @relation(fields: [yearlyReportId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([weeklyReportId, sourceEventId])
  @@unique([monthlyReportId, sourceEventId])
  @@unique([yearlyReportId, sourceEventId])
  @@index([ownerId, sourceEventId])
  @@index([ownerId, sourceMemoryId])
  @@index([ownerId, weeklyReportId])
  @@index([ownerId, monthlyReportId])
  @@index([ownerId, yearlyReportId])
  @@map("AIEvidence")
}

model AiJob {
  id             String      @id @default(cuid())
  ownerId        String
  jobType        AIJobType
  resourceId     String
  eventId        String?
  status         AIJobStatus @default(PENDING)
  attemptCount   Int         @default(0)
  maxAttempts    Int         @default(3)
  nextAttemptAt  DateTime    @default(now())
  lockedAt       DateTime?
  lockedBy       String?     @db.VarChar(128)
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      String?     @db.Text
  idempotencyKey String      @db.VarChar(191)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([ownerId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([ownerId, status, nextAttemptAt])
  @@index([resourceId, jobType])
  @@index([eventId, jobType])
  @@map("AIJob")
}

model SubscriptionEntitlement {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  tier                   SubscriptionTier   @default(FREE)
  status                 SubscriptionStatus @default(INACTIVE)
  source                 String?            @db.VarChar(32)
  externalCustomerId     String?            @unique @db.VarChar(191)
  externalSubscriptionId String?            @unique @db.VarChar(191)
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EmotionSource {
  USER
  MODEL
}

enum ReportCategory {
  HARASSMENT
  HATE_SPEECH
  SELF_HARM
  SPAM
  PRIVACY
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  CANCELED
}

enum AIJobType {
  MEMORY_EXTRACTION
  EMBEDDING_GENERATION
  WEEKLY_REPORT
  MONTHLY_REPORT
  INSIGHT_EXTRACTION
}

enum AIJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AIReportStatus {
  COMPLETE
  PARTIAL
}

enum AIReportNarrativeStatus {
  NOT_GENERATED
  GENERATED
  INSUFFICIENT_EVIDENCE
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// No FK: must survive account erasure to retry identity deletion and deny replay.
model AccountDeletion {
  userId      String    @id
  firebaseUid String    @unique
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}
