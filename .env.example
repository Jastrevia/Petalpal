DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Local backend only: an independent PostgreSQL database on this computer.
DEV_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/petalpal_dev

# Public Firebase Web SDK configuration. Keep environment-specific values out of source.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=petalpal-b212c
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"petalpal-b212c","private_key":"...","client_email":"..."}
# Instead of FIREBASE_SERVICE_ACCOUNT_JSON, Render may use both variables below:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@petalpal-b212c.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Render calls the private Cloudflare Worker with this shared bearer token.
CLOUDFLARE_WORKER_AI_URL=https://petalpal-emotion-ai.YOUR_SUBDOMAIN.workers.dev
CLOUDFLARE_WORKER_AI_TOKEN=replace-with-the-same-value-as-render-shared-secret
# Async AiJob dispatch. Leave manual until staging and production gates pass.
AI_ASYNC_EXECUTION_MODE=manual
AI_ASYNC_SHADOW_OWNER_ID=
AI_ASYNC_SHADOW_STARTED_AT=
AI_JOB_DISPATCH_URL=
AI_JOB_DISPATCH_TOKEN=
AI_JOB_EXECUTOR_TOKEN=
# Comma-separated browser origins. Leave unset when the web app and API share an origin.
CORS_ALLOWED_ORIGINS=
# Keep false unless the listed proxy hops/addresses are verified for the deployment.
TRUST_PROXY=false
AI_REQUEST_TIMEOUT_MS=3000
EMOTION_CLASSIFIER_ENABLED=false
EMOTION_LLM_FALLBACK_THRESHOLD=0.75
EMOTION_CLASSIFIER_AMBIGUITY_MARGIN=0.20

# Per-process Month 1 MVP rate limits (15-minute fixed window by default).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=30

# Test-only bypass. Keep true or unset in production; false allows repeated Daily Grow.
DAILY_GROW_LIMIT_ENABLED=true

# Beta badge (lib/beta-cohort.js). Leave unset during the beta: every account is a beta tester.
# When the beta ends, set an ISO instant; accounts created before it keep the badge.
# BETA_COHORT_ENDS_AT=2026-12-01T08:00:00Z
