{
    "type": "module",
    "scripts": {
        "build:cloudflare": "node scripts/build-cloudflare-web.mjs",
        "test:hosting": "node scripts/test-web-hosting.mjs",
        "start": "npx prisma migrate deploy && node server.js",
        "dev:emotion-lab": "node --env-file-if-exists=.env --env-file-if-exists=.env.auth-e2e.local scripts/start-emotion-lab.js",
        "start:ai-worker": "node scripts/ai-worker.js",
        "backfill:event-memory-embeddings": "node scripts/backfill-event-memory-embeddings.js",
        "build": "EXPO_NO_DOTENV=1 npm run build:web --prefix mobile && node --input-type=module -e \"import { rmSync, cpSync } from 'node:fs'; rmSync('client/dist', { recursive: true, force: true }); cpSync('mobile/dist', 'client/dist', { recursive: true });\"",
        "build:client": "npm run build",
        "lint": "npm run lint --prefix client",
        "test": "npm run test:backend && npm run test:client",
        "test:backend": "DEV_DATABASE_URL=postgresql://test:test@localhost:5432/petalpal_test node --test test/back/*.test.js",
        "test:dast": "node scripts/api-security-fuzz.js",
        "test:social-atomic": "node scripts/api-security-fuzz.js --atomic",
        "test:postgres": "node --test test/back/ai-p0.postgres.test.js",
        "test:client": "npm test --prefix client",
        "test:auth:e2e": "node --env-file-if-exists=.env --env-file-if-exists=.env.auth-e2e.local client/scripts/auth-e2e.mjs",
        "test:data-models": "node --test test/back/verticalSlice.persistence.test.js",
        "benchmark:semantic": "node scripts/benchmark-semantic-retrieval.js",
        "benchmark:semantic:audit": "node scripts/benchmark-semantic-retrieval.js audit",
        "benchmark:semantic:repair-dev": "node scripts/repair-dev-semantic-gold.js",
        "benchmark:embedding-candidates": "node scripts/benchmark-embedding-candidates.js",
        "check": "npm test && npm run lint && npm run build:client && npx prisma validate && node --check server.js && node --check lib/auth.js && node --check lib/firebase-admin.js",
        "postinstall": "npx prisma generate",
        "test:security:ci": "node scripts/security-ci.js"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "0.132.1",
        "@electric-sql/pglite": "^0.3.16"
    },
    "dependencies": {
        "@huggingface/transformers": "^3.8.1",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "ajv": "8.20.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "firebase-admin": "^14.5.0",
        "natural": "^8.1.1",
        "pg": "^8.22.0",
        "prisma": "^7.8.0",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "yaml": "^2.9.0"
    },
    "overrides": {
        "sharp": "^0.35.5"
    }
}
