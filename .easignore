# EAS Build uploads only what the native app needs: the mobile/ folder.
# EAS CLI reads this file only at the Git repository root, and it replaces every .gitignore for
# EAS (https://docs.expo.dev/build-reference/easignore/), so the usual ignores are repeated here.
#
# An allowlist: everything at the repository root stays out, tracked or not (the backend, web
# client, art sources, experiments, docs, and any local file or folder that lands at the root),
# except mobile/. That includes the shallow .git folder EAS would otherwise upload, which carries
# every committed file (Resources/, experiments/ ...) a second time; no build step reads it.
/*
.git
!/mobile/

# Inside mobile/: dependencies are installed on the build server; generated and local files stay out.
node_modules
/mobile/ios/
/mobile/android/
/mobile/dist/
/mobile/web-build/
/mobile/.expo/
/mobile/.perf/
/mobile/.claude/
/mobile/.vscode/
/mobile/test/
/mobile/layout-matrix/
/mobile/expo-env.d.ts
.metro-health-check*
*.tsbuildinfo
*.orig.*

# Local env files: the build takes its values from the EAS environment (eas.json "environment").
/mobile/.env
/mobile/.env.*

# Signing keys and profiles never go in the archive (EAS uses its remote credentials).
*.p8
*.p12
*.jks
*.key
*.pem
*.mobileprovision

.DS_Store
*.log
npm-debug.*
coverage/
